# rhob-backend environment (copy to .env for local use; set as Render environment variables in the cloud)
RHOB_ENV=demo
# SQLite demo (ephemeral on Render!) or PostgreSQL (use Render Postgres internal URL)
DATABASE_URL=sqlite:///./rhob_demo.db
# DATABASE_URL=postgresql://user:password@host:5432/rhob
RHOB_TOKEN_SECRET=change-me-to-a-long-random-string
RHOB_DEMO_AUTH=true
RHOB_MAX_SESSIONS=40
RHOB_AUTO_CREATE_TABLES=true
RHOB_ENABLE_CLOSED_LOOP_EDGE=false
# Only needed if browsers call the API directly (the frontend uses server-to-server calls)
ALLOWED_ORIGINS=
LOG_LEVEL=INFO
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
# Read-only plant adapters (leave empty in the cloud demo)
RHOB_OPCUA_ENDPOINT=
RHOB_LIMS_URL=
RHOB_LIMS_TOKEN=
RHOB_MQTT_BROKER=
